{
  "expo": {
    "name": "k3sher",
    "slug": "k3sher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.k3sher.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "br.com.k3sher.app",
      "versionCode": 2,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./src/assets/logo/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-status-bar",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "13c2f1f2-706e-4bb3-b09d-1c50dc0a0f50"
      }
    }
  }
}
